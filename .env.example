# Copy to .env.local for local development. Never commit real values.
# `npx supabase status` prints the local URL and keys after `npx supabase start`.

# Public (shipped to the browser)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Used for exactly two things: signing 60 s download URLs and the scan worker.
SUPABASE_SERVICE_ROLE_KEY=

# Rate limiting (required in production; local dev falls back to an in-memory limiter)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Error monitoring (optional locally)
SENTRY_DSN=
