# Copy to .env.local for local development. Never commit real values.
# `npx supabase status` prints the local URL and keys after `npx supabase start`.

# ── Public (shipped to the browser) ─────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public URL of the R2 media bucket: its r2.dev URL, or a custom domain later.
NEXT_PUBLIC_MEDIA_URL=https://pub-xxxxxxxx.r2.dev
# Shown on the Privacy, Terms and Copyright pages
NEXT_PUBLIC_CONTACT_EMAIL=

# ── Server only ─────────────────────────────────────────────────────────
# Cloudflare R2 (free tier: 10 GB, free downloads). Create an R2 API token with
# "Object Read & Write" limited to the three buckets below.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_QUARANTINE=yowkly-quarantine
R2_BUCKET_FILES=yowkly-files
R2_BUCKET_MEDIA=yowkly-media

# Rate limiting (required in production; local dev falls back to an in-memory limiter)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Error monitoring (optional)
SENTRY_DSN=

# ── Scan worker and local scripts only (never set these in Vercel) ───────
SUPABASE_SERVICE_ROLE_KEY=
